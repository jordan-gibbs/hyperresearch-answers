{
  "name": "@hyperresearch/langchain",
  "version": "0.1.0",
  "description": "LangChain.js integration for Hyperresearch Answers: a cited, quote-checked answer tool, a raw-source search tool and a retriever.",
  "keywords": ["langchain", "langchainjs", "tools", "retriever", "search", "web-search", "answers", "citations", "agents", "hyperresearch"],
  "homepage": "https://hyperresearch.ai/docs/answers/langchain",
  "repository": {
    "type": "git",
    "url": "https://github.com/jordan-gibbs/hyperresearch-answers",
    "directory": "packages/langchain-js"
  },
  "bugs": { "url": "https://github.com/jordan-gibbs/hyperresearch-answers/issues" },
  "license": "MIT",
  "author": "Hyperresearch",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "@langchain/core": "^1.0.0"
  },
  "dependencies": {
    "zod": "^3.25.76 || ^4.0.0"
  },
  "devDependencies": {
    "@langchain/core": "^1.3.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": { "access": "public", "provenance": true }
}
